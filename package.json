{
  "name": "merch-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tinacms dev -c \"next dev -p 3010\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:plain": "next dev -p 3010",
    "build:vercel": "if [ -n \"$NEXT_PUBLIC_TINA_CLIENT_ID\" ] && [ \"$VERCEL_ENV\" != \"preview\" ]; then npx tinacms build --skip-cloud-checks; fi && next build"
  },
  "dependencies": {
    "@tinacms/cli": "^2.5.5",
    "next": "^15.5.20",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tinacms": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.20",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
