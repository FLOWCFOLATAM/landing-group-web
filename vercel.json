{
  "buildCommand": "npm run build:vercel",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path((?!.well-known(?:/.*)?).*)",
      "has": [
        {
          "type": "host",
          "value": "www.grupolanding.com"
        }
      ],
      "destination": "https://grupolanding.com/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!.well-known(?:/.*)?).*)",
      "has": [
        {
          "type": "host",
          "value": "landing-group-web.vercel.app"
        }
      ],
      "destination": "https://grupolanding.com/:path",
      "permanent": true
    },
    {
      "source": "/agenda",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/agenda/",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/hablemos",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/hablemos/",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/servicios/merch-corporativo",
      "destination": "/soluciones/merch-corporativo/",
      "permanent": true
    },
    {
      "source": "/servicios/merch-corporativo/",
      "destination": "/soluciones/merch-corporativo/",
      "permanent": true
    },
    {
      "source": "/servicios/eventos-btl",
      "destination": "/soluciones/eventos-btl/",
      "permanent": true
    },
    {
      "source": "/servicios/eventos-btl/",
      "destination": "/soluciones/eventos-btl/",
      "permanent": true
    },
    {
      "source": "/servicios/personalizacion",
      "destination": "/como-lo-hacemos/#personalizacion",
      "permanent": true
    },
    {
      "source": "/servicios/personalizacion/",
      "destination": "/como-lo-hacemos/#personalizacion",
      "permanent": true
    },
    {
      "source": "/servicios/produccion",
      "destination": "/como-lo-hacemos/#produccion",
      "permanent": true
    },
    {
      "source": "/servicios/produccion/",
      "destination": "/como-lo-hacemos/#produccion",
      "permanent": true
    },
    {
      "source": "/servicios/logistica",
      "destination": "/como-lo-hacemos/#logistica",
      "permanent": true
    },
    {
      "source": "/servicios/logistica/",
      "destination": "/como-lo-hacemos/#logistica",
      "permanent": true
    },
    {
      "source": "/servicios/acompanamiento",
      "destination": "/como-lo-hacemos/#acompanamiento",
      "permanent": true
    },
    {
      "source": "/servicios/acompanamiento/",
      "destination": "/como-lo-hacemos/#acompanamiento",
      "permanent": true
    },
    {
      "source": "/servicios",
      "destination": "/#soluciones",
      "permanent": true
    },
    {
      "source": "/servicios/",
      "destination": "/#soluciones",
      "permanent": true
    },
    {
      "source": "/soluciones/personalizacion",
      "destination": "/como-lo-hacemos/#personalizacion",
      "permanent": true
    },
    {
      "source": "/soluciones/personalizacion/",
      "destination": "/como-lo-hacemos/#personalizacion",
      "permanent": true
    }
  ]
}
